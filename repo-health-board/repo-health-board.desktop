# Template for the app launcher. The installer writes the real one
# with the ABSOLUTE install path into Exec (see install.sh) - %k
# would resolve to the menu folder, where the program is not.
[Desktop Entry]
Type=Application
Name=Repo Health Board
Comment=See the health of every repo in the org at a glance
Exec="/path/to/repo-health-board/run.sh"
Icon=/path/to/repo-health-board/assets/board.png
Terminal=false
Categories=Utility;
StartupWMClass=Repo Health Board
StartupNotify=false
