#!/usr/bin/env bash
# Vision Image Optimizer command line — run with: bash optimizer-cli <command>
#   bash optimizer-cli --help
#   bash optimizer-cli optimize photo.png --width 512
#   bash optimizer-cli describe photo.png
#   bash optimizer-cli cache-clear
#   bash optimizer-cli debug-report
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve symlinks (the installed command is a symlink into this folder).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$DIR"

if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
else
  PY="python3"
fi

exec "$PY" -m optimizer "$@"
