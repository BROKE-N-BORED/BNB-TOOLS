# Template for the app launcher. The installer writes the real one
# with the ABSOLUTE install path into Exec (see install.sh) - %k
# would resolve to the menu folder, where the program is not.
[Desktop Entry]
Type=Application
Name=Song Key BPM
Comment=Find the key and BPM of your songs
Exec="/path/to/song-key-bpm/run.sh"
Icon=/path/to/song-key-bpm/assets/songkey.png
Terminal=false
Categories=Utility;
StartupWMClass=Song Key BPM
StartupNotify=false
