#!/usr/bin/env bash
# Song Key BPM command line - run with: bash songkey-cli <command>
#   bash songkey-cli --help
#   bash songkey-cli analyze file.wav folder/
#   bash songkey-cli export results.json --format csv
#   bash songkey-cli debug-report
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve symlinks (the installed command is a symlink into this folder).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Stay in the caller's directory: file arguments are
# relative to where the command was run, not to the app
# folder. The package is found through PYTHONPATH.
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"

if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
else
  PY="python3"
fi

exec "$PY" -m songkey "$@"
