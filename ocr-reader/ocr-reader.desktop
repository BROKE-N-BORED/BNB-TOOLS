# Template for the app launcher. The installer writes the real one
# with the ABSOLUTE install path into Exec (see install.sh) - %k
# would resolve to the menu folder, where the program is not.
[Desktop Entry]
Type=Application
Name=OCR Reader
Comment=Read the text out of screenshots and scans
Exec="/path/to/ocr-reader/run.sh"
Icon=/path/to/ocr-reader/assets/ocr.png
Terminal=false
Categories=Utility;
StartupWMClass=OCR Reader
StartupNotify=false
