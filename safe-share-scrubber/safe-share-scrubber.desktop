# Template for the app launcher. The installer writes the real one
# with the ABSOLUTE install path into Exec (see install.sh) - %k
# would resolve to the menu folder, where the program is not.
[Desktop Entry]
Type=Application
Name=Safe Share Scrubber
Comment=Hide secrets before you share a file
Exec="/path/to/safe-share-scrubber/run.sh"
Icon=/path/to/safe-share-scrubber/assets/scrubber.png
Terminal=false
Categories=Utility;
StartupWMClass=Safe Share Scrubber
StartupNotify=false
