# Template for the app launcher. The installer writes the real one
# with the ABSOLUTE install path into Exec (see install.sh) - %k
# would resolve to the menu folder, where the program is not.
[Desktop Entry]
Type=Application
Name=Pre-Load Model Checks
Comment=Check RAM, running processes, and model fit before loading a model
Exec="/path/to/pre-load-model-checks/run.sh"
Icon=/path/to/pre-load-model-checks/assets/preload.png
Terminal=false
Categories=Utility;
StartupWMClass=Pre-Load Model Checks
StartupNotify=false
